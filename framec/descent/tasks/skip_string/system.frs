@@[target("rust")]

// TASK: skip_string — a POSITIONED PROBE. (Same task as efsm.frs.)
//
// CANDIDATE: @@system — a real machine, mode held in Frame STATES.
//
// This is what a SyntaxSkipper *should* look like: `$Scan` / `$InString` /
// `$Escape` are genuine modes with real transitions, not a native `in_string: u8`
// local inside a `while` loop. (Contrast the 15 shipped skippers, which are
// `$Init` + one state per interface method — a vtable, not a machine.)
//
// THE POINT OF THIS CANDIDATE: a Frame system's domain field must OWN its data.
// There is no borrowed input type. So the driver must hand it a COPY of the
// buffer on every probe:
//
//     m.bytes = bytes[..end].to_vec();     // <-- #209, 71 sites in the real skippers
//
// A copy is O(n). The sweep makes n probes. The scan itself is trivial.
// Therefore: O(n^2), and the battery should measure ~4x per input doubling.
//
// That is not a defect of this file. It is the language gap (RFC-0056 P9), and
// measuring it is the whole reason this task exists.
@@system SysSkipString {
    interface:
        // Probe at `i`. Afterwards: `ok` says whether a string started there,
        // and `result` is the byte just past its closing quote.
        skip_at(i: usize)

    machine:
        $Scan {
            skip_at(i: usize) {
                @@:self.ok = false;
                @@:self.result = 0;
                @@:self.pos = i;
                if @@:self.pos >= @@:self.end { return; }
                if @@:self.bytes[@@:self.pos] != b'"' { return; }
                @@:self.pos = @@:self.pos + 1;
                -> $InString
            }
        }

        // Mode: inside the string literal. A Frame STATE, not a native bool.
        $InString {
            $>() {
                while @@:self.pos < @@:self.end {
                    let b = @@:self.bytes[@@:self.pos];
                    @@:self.pos = @@:self.pos + 1;
                    if b == b'\\' {
                        // Escape: consume the next byte, whatever it is.
                        if @@:self.pos < @@:self.end {
                            @@:self.pos = @@:self.pos + 1;
                        }
                    } else if b == b'"' {
                        @@:self.ok = true;
                        @@:self.result = @@:self.pos;
                        break;
                    }
                }
                -> $Scan
            }
        }

    domain:
        bytes: Vec<u8> = Vec::new()
        end: usize = 0
        pos: usize = 0
        ok: bool = false
        result: usize = 0
}
