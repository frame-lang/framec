@@[target("rust")]

// TASK: skip_string — a POSITIONED PROBE. (Same task as efsm.frs.)
//
// CANDIDATE: @@system — a real machine, mode held in Frame STATES.
//
// This is what a SyntaxSkipper *should* look like: `$Scan` / `$InString` /
// `$Escape` are genuine modes with real transitions, not a native `in_string: u8`
// local inside a `while` loop. (Contrast the 15 shipped skippers, which are
// `$Init` + one state per interface method — a vtable, not a machine.)
//
// The header param `text: bytes` is an ALPHABET TYPE, so it is the system's
// BORROWED INPUT SOURCE (RFC-0056 P9) — the same rule `@@fsm` uses. The system is
// generic over it (`SysSkipString<I: SysSkipStringInput>`), so it scans a buffer
// it does NOT own, and reads it through the indexed accessors `get(i)` / `len()`.
//
// This closes #209. Before P9, a Frame system's domain field had to own its data,
// so a positioned probe copied the whole buffer on EVERY call — 71 such sites in
// the real skippers, and the reason their scan logic was hand-rolled into native
// loops (which is where the mode landed in a native local, which IS the
// string-blindness bug family).
//
// The battery measures the difference.
@@system SysSkipString(text: bytes) {
    interface:
        // Probe at `i`. Afterwards: `ok` says whether a string started there,
        // and `result` is the byte just past its closing quote.
        skip_at(i: usize)

    machine:
        $Scan {
            skip_at(i: usize) {
                @@:self.ok = false;
                @@:self.result = 0;
                @@:self.pos = i;
                if @@:self.pos >= @@:self.end { return; }
                if @@:self.text.get(@@:self.pos) != b'"' { return; }
                @@:self.pos = @@:self.pos + 1;
                -> $InString
            }
        }

        // Mode: inside the string literal. A Frame STATE, not a native bool.
        $InString {
            $>() {
                while @@:self.pos < @@:self.end {
                    let b = @@:self.text.get(@@:self.pos);
                    @@:self.pos = @@:self.pos + 1;
                    if b == b'\\' {
                        // Escape: consume the next byte, whatever it is.
                        if @@:self.pos < @@:self.end {
                            @@:self.pos = @@:self.pos + 1;
                        }
                    } else if b == b'"' {
                        @@:self.ok = true;
                        @@:self.result = @@:self.pos;
                        break;
                    }
                }
                -> $Scan
            }
        }

    domain:
        end: usize = 0
        pos: usize = 0
        ok: bool = false
        result: usize = 0
}
