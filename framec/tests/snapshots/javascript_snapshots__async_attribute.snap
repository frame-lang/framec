class Cache {
    get(k) { return "v:" + k; }
}

export class AsyncFetcherFrameEvent {
    _message;
    _parameters;

    constructor(message, parameters) {
        this._message = message;
        this._parameters = parameters;
    }
}


export class AsyncFetcherFrameContext {
    event;
    _return;
    _data;
    _transitioned;

    constructor(event, default_return) {
        this.event = event;
        this._return = default_return;
        this._data = {  };
        this._transitioned = false;
    }
}


export class AsyncFetcherCompartment {
    state;
    state_args;
    state_vars;
    enter_args;
    exit_args;
    forward_event;
    parent_compartment;

    constructor(state, parent_compartment = null) {
        this.state = state;
        this.state_args = [];
        this.state_vars = {  };
        this.enter_args = [];
        this.exit_args = [];
        this.forward_event = null;
        this.parent_compartment = parent_compartment;
    }

    copy() {
        const c = new AsyncFetcherCompartment(this.state, this.parent_compartment);
        c.state_args = {...this.state_args};
        c.state_vars = {...this.state_vars};
        c.enter_args = {...this.enter_args};
        c.exit_args = {...this.exit_args};
        c.forward_event = this.forward_event;
        return c;
    }
}


export class AsyncFetcher {
    constructor() {
        this.machine = new _AsyncFetcherMachine();
        this.busy = false;
        this.in_flight = null;
    }

    _frame_init() {
    }

    static _create() {
        const c = new AsyncFetcher();
        c._frame_init();
        return c;
    }

    async fetch(key) {
        if (this.busy) {
            throw new Error(
                `E703: system busy: cannot enter 'fetch' while '${this.in_flight}' is in flight`
            );
        }
        this.busy = true;
        this.in_flight = "fetch";
        try {
            return await this.machine.fetch(key);
        } finally {
            this.in_flight = null;
            this.busy = false;
        }
    }

    async init() {
        await this.machine.init();
    }
}


export class _AsyncFetcherMachine {
    _state_stack;
    __compartment;
    __next_compartment;
    _context_stack;
    cache = null;

    constructor() {
        this._state_stack = [];
        this._context_stack = [];
        this.__compartment = this.__prepareEnter("Ready", [], []);
        this.__next_compartment = null;
    }

    _frame_init() {
    }

    static _create() {
        const c = new _AsyncFetcherMachine();
        c._frame_init();
        return c;
    }

    static _HSM_CHAIN = {
        "Ready": ["Ready"],
    };
    __prepareEnter(leaf, state_args, enter_args) {
        let comp = null;
        for (const name of _AsyncFetcherMachine._HSM_CHAIN[leaf]) {
            const new_comp = new AsyncFetcherCompartment(name);
            new_comp.state_args = [...state_args];
            new_comp.enter_args = [...enter_args];
            new_comp.parent_compartment = comp;
            comp = new_comp;
        }
        return comp;
    }

    __prepareExit(exit_args) {
        let comp = this.__compartment;
        while (comp !== null) {
            comp.exit_args = [...exit_args];
            comp = comp.parent_compartment;
        }
    }

    async __kernel(__e) {
        // Route event to current state.
        await this.__router(__e);
        // Drain any transitions queued by the handler.
        while (this.__next_compartment !== null) {
            const next_compartment = this.__next_compartment;
            this.__next_compartment = null;
            // Exit the current (leaf) state.
            const exit_event = new AsyncFetcherFrameEvent("<$", this.__compartment.exit_args);
            await this.__router(exit_event);
            // Switch to the new compartment.
            this.__compartment = next_compartment;
            // Three-branch forward-event handling.
            const forward_event = next_compartment.forward_event;
            next_compartment.forward_event = null;
            if (forward_event === null) {
                // No forwarded event — synthesize a fresh $>.
                const enter_event = new AsyncFetcherFrameEvent("$>", this.__compartment.enter_args);
                await this.__router(enter_event);
            } else if (forward_event._message === "$>") {
                // Forwarded event IS $> — dispatch directly so the
                // destination's $> handler receives the caller's payload.
                await this.__router(forward_event);
            } else {
                // Forwarded event is not $> — initialize the destination
                // with a fresh $>, then dispatch the forward.
                const enter_event = new AsyncFetcherFrameEvent("$>", this.__compartment.enter_args);
                await this.__router(enter_event);
                await this.__router(forward_event);
            }
            for (const ctx of this._context_stack) {
                ctx._transitioned = true;
            }
        }
    }

    async __router(__e) {
        const handler_name = `_state_${this.__compartment.state}`;
        const handler = this[handler_name];
        if (handler) {
            await handler.call(this, __e, this.__compartment);
        }
    }

    __transition(next_compartment) {
        this.__next_compartment = next_compartment;
    }

    async fetch(key) {
        const __e = new AsyncFetcherFrameEvent("fetch", [key]);
        const __ctx = new AsyncFetcherFrameContext(__e, null);
        this._context_stack.push(__ctx);
        try {
            await this.__kernel(__e);
            return this._context_stack.pop()._return;
        } catch (__frame_err) {
            this._context_stack.pop();
            throw __frame_err;
        }
    }

    async _state_Ready(__e, compartment) {
        if (__e._message === "fetch") {
            await this._s_Ready_hdl_user_fetch(__e, compartment);
            return;
        }
    }

    async _s_Ready_hdl_user_fetch(__e, compartment) {
        const key = __e._parameters[0];
        this._context_stack[this._context_stack.length - 1]._return = this.cache.get(key);
    }

    async init() {
        const __e = new AsyncFetcherFrameEvent("$>", []);
        const __ctx = new AsyncFetcherFrameContext(__e, null);
        this._context_stack.push(__ctx);
        await this.__kernel(__e);
        this._context_stack.pop();
    }
}
