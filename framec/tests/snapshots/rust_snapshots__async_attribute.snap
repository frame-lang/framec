        pub async fn fetch(&mut self, key: String) -> Result<String, FrameE703Error> {
            if self.busy {
                return Err(FrameE703Error {
                    method: "fetch",
                    in_flight: self.in_flight,
                });
            }
            self.busy = true;
            self.in_flight = Some("fetch");
            let _guard = _GateGuard {
                busy: &mut self.busy,
                in_flight: &mut self.in_flight,
            };
            Ok(self.machine.fetch(key).await)
