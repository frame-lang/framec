    struct _GateGuard<'a> {
        busy: &'a mut bool,
        in_flight: &'a mut Option<&'static str>,
    }

    impl<'a> Drop for _GateGuard<'a> {
        fn drop(&mut self) {
            *self.busy = false;
            *self.in_flight = None;
        }
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct FrameE703Error {
