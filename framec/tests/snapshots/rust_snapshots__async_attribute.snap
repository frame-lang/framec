    }

    impl std::error::Error for FrameE703Error {}

    #[allow(dead_code)]
    struct _AsyncFetcherMachine {
        _state_stack: Vec<AsyncFetcherCompartment>,
        __compartment: AsyncFetcherCompartment,
        __next_compartment: Option<AsyncFetcherCompartment>,
        _context_stack: Vec<AsyncFetcherFrameContext>,
        pub cache: Cache,
    }

    #[allow(non_snake_case)]
    impl _AsyncFetcherMachine {
        pub fn new() -> Self {
            Self {
                _state_stack: Vec::new(),
                _context_stack: Vec::new(),
                cache: nil,
                __compartment: AsyncFetcherCompartment::new("Ready"),
                __next_compartment: None,
            }
