struct LifecycleArgs {
    LifecycleArgs_FrameVec* _state_stack;
    LifecycleArgs_Compartment* __compartment;
    LifecycleArgs_Compartment* __next_compartment;
    LifecycleArgs_FrameVec* _context_stack;
    int sum;
    char* label;
};

LifecycleArgs* LifecycleArgs_new(void) {
    LifecycleArgs* self = calloc(1, sizeof(LifecycleArgs));
    self->_state_stack = LifecycleArgs_FrameVec_new();
    self->_context_stack = LifecycleArgs_FrameVec_new();
    self->sum = 0;
    self->label = "";
    LifecycleArgs_FrameVec* __sa = NULL;
    LifecycleArgs_FrameVec* __ea = NULL;
    self->__compartment = LifecycleArgs_prepareEnter(self, "Idle", __sa, __ea);
    self->__next_compartment = NULL;
    LifecycleArgs_FrameEvent* __e = LifecycleArgs_FrameEvent_new("$>", self->__compartment->enter_args, 0);
    LifecycleArgs_FrameContext* __ctx = LifecycleArgs_FrameContext_new(__e, NULL);
    LifecycleArgs_FrameVec_push(self->_context_stack, __ctx);
    LifecycleArgs_FrameContext* __init_ctx = (LifecycleArgs_FrameContext*)LifecycleArgs_FrameVec_pop(self->_context_stack);
    LifecycleArgs_FrameContext_destroy(__init_ctx);
    LifecycleArgs_FrameEvent_destroy(__e);
    return self;
}

