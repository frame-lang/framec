static void LifecycleArgs_state_Idle(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e, LifecycleArgs_Compartment* compartment) {
    if (strcmp(__e->_message, "load") == 0) {
        LifecycleArgs_s_Idle_hdl_user_load(self, __e, compartment);
        return;
    }
}

static void LifecycleArgs_state_Active(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e, LifecycleArgs_Compartment* compartment) {
    if (strcmp(__e->_message, "$>") == 0) {
        LifecycleArgs_s_Active_hdl_frame_enter(self, __e, compartment);
        return;
    }
    if (strcmp(__e->_message, "tag") == 0) {
        LifecycleArgs_s_Active_hdl_user_tag(self, __e, compartment);
        return;
    }
    if (strcmp(__e->_message, "total") == 0) {
        LifecycleArgs_s_Active_hdl_user_total(self, __e, compartment);
        return;
    }
}

static void LifecycleArgs_s_Idle_hdl_user_load(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e, LifecycleArgs_Compartment* compartment) {
    int n = (int)(intptr_t)LifecycleArgs_FrameVec_get(__e->_parameters, 0);
    (void)n;
    const char* label = (const char*)LifecycleArgs_FrameVec_get(__e->_parameters, 1);
    (void)label;
    {
        LifecycleArgs_FrameVec* __sa = NULL;
        LifecycleArgs_FrameVec* __ea = LifecycleArgs_FrameVec_new();
        LifecycleArgs_FrameVec_push(__ea, (void*)(intptr_t)(n));
        LifecycleArgs_FrameVec_push(__ea, (void*)(intptr_t)(label));
        LifecycleArgs_Compartment* __compartment = LifecycleArgs_prepareEnter(self, "Active", __sa, __ea);
        LifecycleArgs_FrameVec_destroy(__ea);
        LifecycleArgs_transition(self, __compartment);
    }
    return;
}

static void LifecycleArgs_s_Active_hdl_frame_enter(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e, LifecycleArgs_Compartment* compartment) {
    int count = (int)(intptr_t)LifecycleArgs_FrameVec_get(compartment->enter_args, 0);
    (void)count;
    const char* name = (const char*)LifecycleArgs_FrameVec_get(compartment->enter_args, 1);
    (void)name;
    self->sum = count + 1;
    self->label = name;
}

static void LifecycleArgs_s_Active_hdl_user_tag(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e, LifecycleArgs_Compartment* compartment) {
    LifecycleArgs_CTX(self)->_return = (void*)(intptr_t)(self->label);
                    return
}

static void LifecycleArgs_s_Active_hdl_user_total(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e, LifecycleArgs_Compartment* compartment) {
    LifecycleArgs_CTX(self)->_return = (void*)(intptr_t)(self->sum);
                    return
