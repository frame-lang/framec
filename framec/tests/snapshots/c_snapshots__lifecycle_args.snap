#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdint.h>

// ============================================================================
// LifecycleArgs_FrameDict - String-keyed dictionary
// ============================================================================

typedef struct LifecycleArgs_FrameDictEntry {
    char* key;
    void* value;
    struct LifecycleArgs_FrameDictEntry* next;
} LifecycleArgs_FrameDictEntry;

typedef struct {
    LifecycleArgs_FrameDictEntry** buckets;
    int bucket_count;
    int size;
} LifecycleArgs_FrameDict;

static unsigned int LifecycleArgs_hash_string(const char* str) {
    unsigned int hash = 5381;
    int c;
    while ((c = *str++)) {
        hash = ((hash << 5) + hash) + c;
    }
    return hash;
}

static LifecycleArgs_FrameDict* LifecycleArgs_FrameDict_new(void) {
    LifecycleArgs_FrameDict* d = malloc(sizeof(LifecycleArgs_FrameDict));
    d->bucket_count = 16;
    d->buckets = calloc(d->bucket_count, sizeof(LifecycleArgs_FrameDictEntry*));
    d->size = 0;
    return d;
}

static void LifecycleArgs_FrameDict_set(LifecycleArgs_FrameDict* d, const char* key, void* value) {
    unsigned int idx = LifecycleArgs_hash_string(key) % d->bucket_count;
    LifecycleArgs_FrameDictEntry* entry = d->buckets[idx];
    while (entry) {
        if (strcmp(entry->key, key) == 0) {
            entry->value = value;
            return;
        }
        entry = entry->next;
    }
    LifecycleArgs_FrameDictEntry* new_entry = malloc(sizeof(LifecycleArgs_FrameDictEntry));
    new_entry->key = strdup(key);
    new_entry->value = value;
    new_entry->next = d->buckets[idx];
    d->buckets[idx] = new_entry;
    d->size++;
}

static void* LifecycleArgs_FrameDict_get(LifecycleArgs_FrameDict* d, const char* key) {
    unsigned int idx = LifecycleArgs_hash_string(key) % d->bucket_count;
    LifecycleArgs_FrameDictEntry* entry = d->buckets[idx];
    while (entry) {
        if (strcmp(entry->key, key) == 0) {
            return entry->value;
        }
        entry = entry->next;
    }
    return NULL;
}

static int LifecycleArgs_FrameDict_has(LifecycleArgs_FrameDict* d, const char* key) {
    unsigned int idx = LifecycleArgs_hash_string(key) % d->bucket_count;
    LifecycleArgs_FrameDictEntry* entry = d->buckets[idx];
    while (entry) {
        if (strcmp(entry->key, key) == 0) {
            return 1;
        }
        entry = entry->next;
    }
    return 0;
}

static LifecycleArgs_FrameDict* LifecycleArgs_FrameDict_copy(LifecycleArgs_FrameDict* src) {
    LifecycleArgs_FrameDict* dst = LifecycleArgs_FrameDict_new();
    for (int i = 0; i < src->bucket_count; i++) {
        LifecycleArgs_FrameDictEntry* entry = src->buckets[i];
        while (entry) {
            LifecycleArgs_FrameDict_set(dst, entry->key, entry->value);
            entry = entry->next;
        }
    }
    return dst;
}

static void LifecycleArgs_FrameDict_destroy(LifecycleArgs_FrameDict* d) {
    for (int i = 0; i < d->bucket_count; i++) {
        LifecycleArgs_FrameDictEntry* entry = d->buckets[i];
        while (entry) {
            LifecycleArgs_FrameDictEntry* next = entry->next;
            free(entry->key);
            free(entry);
            entry = next;
        }
    }
    free(d->buckets);
    free(d);
}

// ============================================================================
// LifecycleArgs_FrameVec - Dynamic array
// ============================================================================

typedef struct {
    void** items;
    int size;
    int capacity;
} LifecycleArgs_FrameVec;

static LifecycleArgs_FrameVec* LifecycleArgs_FrameVec_new(void) {
    LifecycleArgs_FrameVec* v = malloc(sizeof(LifecycleArgs_FrameVec));
    v->capacity = 8;
    v->size = 0;
    v->items = malloc(sizeof(void*) * v->capacity);
    return v;
}

static void LifecycleArgs_FrameVec_push(LifecycleArgs_FrameVec* v, void* item) {
    if (v->size >= v->capacity) {
        v->capacity *= 2;
        v->items = realloc(v->items, sizeof(void*) * v->capacity);
    }
    v->items[v->size++] = item;
}

static void* LifecycleArgs_FrameVec_pop(LifecycleArgs_FrameVec* v) {
    if (v->size == 0) return NULL;
    return v->items[--v->size];
}

static void* LifecycleArgs_FrameVec_last(LifecycleArgs_FrameVec* v) {
    if (v->size == 0) return NULL;
    return v->items[v->size - 1];
}

static void* LifecycleArgs_FrameVec_get(LifecycleArgs_FrameVec* v, int index) {
    if (index < 0 || index >= v->size) return NULL;
    return v->items[index];
}

static int LifecycleArgs_FrameVec_size(LifecycleArgs_FrameVec* v) {
    return v->size;
}

static void LifecycleArgs_FrameVec_destroy(LifecycleArgs_FrameVec* v) {
    if (!v) return;
    free(v->items);
    free(v);
}

static LifecycleArgs_FrameVec* LifecycleArgs_FrameVec_copy(LifecycleArgs_FrameVec* src) {
    if (!src) return NULL;
    LifecycleArgs_FrameVec* v = LifecycleArgs_FrameVec_new();
    for (int i = 0; i < src->size; i++) {
        LifecycleArgs_FrameVec_push(v, src->items[i]);
    }
    return v;
}

// ============================================================================
// LifecycleArgs_pack_double / LifecycleArgs_unpack_double — bit-pun doubles through void*
// ============================================================================

static inline void* LifecycleArgs_pack_double(double v) {
    void* p = 0;
    memcpy(&p, &v, sizeof(double));
    return p;
}

static inline double LifecycleArgs_unpack_double(void* p) {
    double d;
    memcpy(&d, &p, sizeof(double));
    return d;
}

// ============================================================================
// LifecycleArgs_FrameEvent - Event routing object
// ============================================================================

typedef struct {
    const char* _message;
    LifecycleArgs_FrameVec* _parameters;
    int _owns_parameters;
} LifecycleArgs_FrameEvent;

static LifecycleArgs_FrameEvent* LifecycleArgs_FrameEvent_new(const char* message, LifecycleArgs_FrameVec* parameters, int owns_parameters) {
    LifecycleArgs_FrameEvent* e = malloc(sizeof(LifecycleArgs_FrameEvent));
    e->_message = message;
    e->_parameters = parameters;
    e->_owns_parameters = owns_parameters;
    return e;
}

static void LifecycleArgs_FrameEvent_destroy(LifecycleArgs_FrameEvent* e) {
    if (e->_owns_parameters && e->_parameters) LifecycleArgs_FrameVec_destroy(e->_parameters);
    free(e);
}

// ============================================================================
// LifecycleArgs_FrameContext - Interface call context
// ============================================================================

typedef struct {
    LifecycleArgs_FrameEvent* event;
    void* _return;
    LifecycleArgs_FrameDict* _data;
    int _transitioned;
} LifecycleArgs_FrameContext;

static LifecycleArgs_FrameContext* LifecycleArgs_FrameContext_new(LifecycleArgs_FrameEvent* event, void* default_return) {
    LifecycleArgs_FrameContext* ctx = malloc(sizeof(LifecycleArgs_FrameContext));
    ctx->event = event;
    ctx->_return = default_return;
    ctx->_data = LifecycleArgs_FrameDict_new();
    ctx->_transitioned = 0;
    return ctx;
}

static void LifecycleArgs_FrameContext_destroy(LifecycleArgs_FrameContext* ctx) {
    LifecycleArgs_FrameDict_destroy(ctx->_data);
    free(ctx);
}

// ============================================================================
// LifecycleArgs_Compartment - State closure
// ============================================================================

typedef struct LifecycleArgs_Compartment {
    const char* state;
    LifecycleArgs_FrameVec* state_args;
    LifecycleArgs_FrameDict* state_vars;
    LifecycleArgs_FrameVec* enter_args;
    LifecycleArgs_FrameVec* exit_args;
    LifecycleArgs_FrameEvent* forward_event;
    struct LifecycleArgs_Compartment* parent_compartment;
    int _ref_count;
} LifecycleArgs_Compartment;

static LifecycleArgs_Compartment* LifecycleArgs_Compartment_new(const char* state) {
    LifecycleArgs_Compartment* c = malloc(sizeof(LifecycleArgs_Compartment));
    c->state = state;
    c->state_args = LifecycleArgs_FrameVec_new();
    c->state_vars = LifecycleArgs_FrameDict_new();
    c->enter_args = LifecycleArgs_FrameVec_new();
    c->exit_args = LifecycleArgs_FrameVec_new();
    c->forward_event = NULL;
    c->parent_compartment = NULL;
    c->_ref_count = 1;
    return c;
}

static LifecycleArgs_Compartment* LifecycleArgs_Compartment_ref(LifecycleArgs_Compartment* c) {
    if (c) c->_ref_count++;
    return c;
}

static void LifecycleArgs_Compartment_unref(LifecycleArgs_Compartment* c);
static void LifecycleArgs_Compartment_unref(LifecycleArgs_Compartment* c) {
    if (c == NULL) return;
    c->_ref_count--;
    if (c->_ref_count <= 0) {
        LifecycleArgs_Compartment_unref(c->parent_compartment);
        LifecycleArgs_FrameVec_destroy(c->state_args);
        LifecycleArgs_FrameDict_destroy(c->state_vars);
        LifecycleArgs_FrameVec_destroy(c->enter_args);
        LifecycleArgs_FrameVec_destroy(c->exit_args);
        free(c);
    }
}

static LifecycleArgs_Compartment* LifecycleArgs_Compartment_copy(LifecycleArgs_Compartment* src) {
    LifecycleArgs_Compartment* c = malloc(sizeof(LifecycleArgs_Compartment));
    c->state = src->state;
    c->state_args = LifecycleArgs_FrameVec_copy(src->state_args);
    c->state_vars = LifecycleArgs_FrameDict_copy(src->state_vars);
    c->enter_args = LifecycleArgs_FrameVec_copy(src->enter_args);
    c->exit_args = LifecycleArgs_FrameVec_copy(src->exit_args);
    c->forward_event = src->forward_event;  // Shallow copy OK
    c->parent_compartment = src->parent_compartment;
    return c;
}

static void LifecycleArgs_Compartment_destroy(LifecycleArgs_Compartment* c) {
    LifecycleArgs_FrameVec_destroy(c->state_args);
    LifecycleArgs_FrameDict_destroy(c->state_vars);
    LifecycleArgs_FrameVec_destroy(c->enter_args);
    LifecycleArgs_FrameVec_destroy(c->exit_args);
    free(c);
}

