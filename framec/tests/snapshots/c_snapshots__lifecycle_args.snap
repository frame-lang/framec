static int LifecycleArgs_hsm_chain(LifecycleArgs* self, const char* leaf, const char*** out_chain) {
    if (false) { (void)0; }
        else if (strcmp(leaf, "Idle") == 0) {
            static const char* __chain[] = { "Idle" };
            *out_chain = __chain;
            return 1;
        }
        else if (strcmp(leaf, "Active") == 0) {
            static const char* __chain[] = { "Active" };
            *out_chain = __chain;
            return 1;
        }
        *out_chain = NULL;
        return 0;
}

static LifecycleArgs_Compartment* LifecycleArgs_prepareEnter(LifecycleArgs* self, const char* leaf, LifecycleArgs_FrameVec* state_args, LifecycleArgs_FrameVec* enter_args) {
    const char** chain = NULL;
    int n = LifecycleArgs_hsm_chain(self, leaf, &chain);
    LifecycleArgs_Compartment* comp = NULL;
    for (int i = 0; i < n; i++) {
        LifecycleArgs_Compartment* nc = LifecycleArgs_Compartment_new(chain[i]);
        if (state_args) {
            for (int j = 0; j < state_args->size; j++) LifecycleArgs_FrameVec_push(nc->state_args, state_args->items[j]);
        }
        if (enter_args) {
            for (int j = 0; j < enter_args->size; j++) LifecycleArgs_FrameVec_push(nc->enter_args, enter_args->items[j]);
        }
        nc->parent_compartment = comp;  // adopts ref
        comp = nc;
    }
    return comp;
}

static void LifecycleArgs_prepareExit(LifecycleArgs* self, LifecycleArgs_FrameVec* exit_args) {
    LifecycleArgs_Compartment* comp = self->__compartment;
    while (comp != NULL) {
        // Clear any prior exit_args before copying the new ones in.
        while (comp->exit_args->size > 0) comp->exit_args->size--;
        if (exit_args) {
            for (int j = 0; j < exit_args->size; j++) LifecycleArgs_FrameVec_push(comp->exit_args, exit_args->items[j]);
        }
        comp = comp->parent_compartment;
    }
}

static void LifecycleArgs_kernel(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e) {
    LifecycleArgs_router(self, __e);
    while (self->__next_compartment != NULL) {
        LifecycleArgs_Compartment* next_compartment = self->__next_compartment;
        self->__next_compartment = NULL;
        // Exit the current (leaf) state
        LifecycleArgs_FrameEvent* __exit_event = LifecycleArgs_FrameEvent_new("<$", self->__compartment->exit_args, 0);
        LifecycleArgs_router(self, __exit_event);
        LifecycleArgs_FrameEvent_destroy(__exit_event);
        LifecycleArgs_Compartment_unref(self->__compartment);
        self->__compartment = next_compartment;
        if (next_compartment->forward_event == NULL) {
            // No forwarded event — synthesize a fresh $>
            LifecycleArgs_FrameEvent* __enter_event = LifecycleArgs_FrameEvent_new("$>", self->__compartment->enter_args, 0);
            LifecycleArgs_router(self, __enter_event);
            LifecycleArgs_FrameEvent_destroy(__enter_event);
        } else if (strcmp(next_compartment->forward_event->_message, "$>") == 0) {
            // Forwarded event IS $> — dispatch directly so the
            // destination's $> handler receives the caller's payload.
            // The forward_event is borrowed (owned by the wrapper that
            // queued the transition) — do NOT destroy it here.
            LifecycleArgs_FrameEvent* forward_event = next_compartment->forward_event;
            next_compartment->forward_event = NULL;
            LifecycleArgs_router(self, forward_event);
        } else {
            // Forwarded event is not $> — initialize the destination
            // with a fresh $>, then dispatch the forward to it. The
            // forward_event is borrowed; only the synthesized $> belongs
            // to the kernel and is freed here.
            LifecycleArgs_FrameEvent* forward_event = next_compartment->forward_event;
            next_compartment->forward_event = NULL;
            LifecycleArgs_FrameEvent* __enter_event = LifecycleArgs_FrameEvent_new("$>", self->__compartment->enter_args, 0);
            LifecycleArgs_router(self, __enter_event);
            LifecycleArgs_FrameEvent_destroy(__enter_event);
            LifecycleArgs_router(self, forward_event);
        }
        // Mark every stacked context as having transitioned. Read by
        // @@:self.X() guard so outer self-calls short-circuit.
        for (int __i = 0; __i < self->_context_stack->size; __i++) {
            ((LifecycleArgs_FrameContext*)self->_context_stack->items[__i])->_transitioned = 1;
        }
    }
}

static void LifecycleArgs_router(LifecycleArgs* self, LifecycleArgs_FrameEvent* __e) {
    if (strcmp(self->__compartment->state, "Idle") == 0) {
        LifecycleArgs_state_Idle(self, __e, self->__compartment);
    } else if (strcmp(self->__compartment->state, "Active") == 0) {
        LifecycleArgs_state_Active(self, __e, self->__compartment);
    }
}

static void LifecycleArgs_transition(LifecycleArgs* self, LifecycleArgs_Compartment* next_compartment) {
    self->__next_compartment = next_compartment;
}

void LifecycleArgs_destroy(LifecycleArgs* self) {
    // Unref current compartment (may free if not on stack)
    if (self->__compartment) LifecycleArgs_Compartment_unref(self->__compartment);
    if (self->__next_compartment) LifecycleArgs_Compartment_unref(self->__next_compartment);
    // Unref all state stack entries
    if (self->_state_stack) {
        for (int __i = 0; __i < self->_state_stack->size; __i++) {
            LifecycleArgs_Compartment_unref((LifecycleArgs_Compartment*)self->_state_stack->items[__i]);
        }
        LifecycleArgs_FrameVec_destroy(self->_state_stack);
    }
    if (self->_context_stack) LifecycleArgs_FrameVec_destroy(self->_context_stack);
    free(self);
}

void LifecycleArgs_load(LifecycleArgs* self, int n, char* label) {
    LifecycleArgs_FrameVec* __params = LifecycleArgs_FrameVec_new();
    LifecycleArgs_FrameVec_push(__params, (void*)(intptr_t)n);
    LifecycleArgs_FrameVec_push(__params, (void*)(intptr_t)label);
    LifecycleArgs_FrameEvent* __e = LifecycleArgs_FrameEvent_new("load", __params, 1);
    LifecycleArgs_FrameContext* __ctx = LifecycleArgs_FrameContext_new(__e, NULL);
    LifecycleArgs_FrameVec_push(self->_context_stack, __ctx);
    LifecycleArgs_kernel(self, __e);
    LifecycleArgs_FrameContext* __result_ctx = (LifecycleArgs_FrameContext*)LifecycleArgs_FrameVec_pop(self->_context_stack);
    LifecycleArgs_FrameContext_destroy(__result_ctx);
    LifecycleArgs_FrameEvent_destroy(__e);
}

int LifecycleArgs_total(LifecycleArgs* self) {
    LifecycleArgs_FrameEvent* __e = LifecycleArgs_FrameEvent_new("total", NULL, 0);
    LifecycleArgs_FrameContext* __ctx = LifecycleArgs_FrameContext_new(__e, NULL);
    LifecycleArgs_FrameVec_push(self->_context_stack, __ctx);
    LifecycleArgs_kernel(self, __e);
    LifecycleArgs_FrameContext* __result_ctx = (LifecycleArgs_FrameContext*)LifecycleArgs_FrameVec_pop(self->_context_stack);
    int __result = (int)(intptr_t)__result_ctx->_return;
    LifecycleArgs_FrameContext_destroy(__result_ctx);
    LifecycleArgs_FrameEvent_destroy(__e);
    return __result;
}

char* LifecycleArgs_tag(LifecycleArgs* self) {
    LifecycleArgs_FrameEvent* __e = LifecycleArgs_FrameEvent_new("tag", NULL, 0);
    LifecycleArgs_FrameContext* __ctx = LifecycleArgs_FrameContext_new(__e, NULL);
    LifecycleArgs_FrameVec_push(self->_context_stack, __ctx);
