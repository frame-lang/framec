#define LifecycleArgs_CTX(self) ((LifecycleArgs_FrameContext*)LifecycleArgs_FrameVec_last((self)->_context_stack))
#define LifecycleArgs_PARAM(self, key) LifecycleArgs_FrameDict_get(LifecycleArgs_CTX(self)->event->_parameters, key)
#define LifecycleArgs_RETURN(self) LifecycleArgs_CTX(self)->_return
#define LifecycleArgs_DATA(self, key) LifecycleArgs_FrameDict_get(LifecycleArgs_CTX(self)->_data, key)
