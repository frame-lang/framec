class AsyncFetcher {
private:
    _AsyncFetcherMachine machine;
    bool busy;
    std::string in_flight;

public:
    AsyncFetcher() {
        this->busy = false;
    }

    static AsyncFetcher __create() {
        AsyncFetcher c;
        return c;
    }

    FrameTask<std::string> fetch(std::string key) {
        if (this->busy) {
        #if defined(__cpp_exceptions) || defined(__EXCEPTIONS)
            throw std::runtime_error(
                "E703: system busy: cannot enter 'fetch' while '" + this->in_flight + "' is in flight"
            );
        #else
            std::fprintf(stderr, "E703: system busy: cannot enter 'fetch' while '%s' is in flight\n", this->in_flight.c_str());
            std::abort();
        #endif
        }
        this->busy = true;
        this->in_flight = "fetch";
        struct __E703Guard { bool* __b; std::string* __f; ~__E703Guard() { __f->clear(); *__b = false; } } __e703_guard{&this->busy, &this->in_flight};
        auto __result = co_await this->machine.fetch(key);
        co_return __result;

    }

    FrameTask<void> init() {
        co_await this->machine.init();
        co_return;

    }
};
