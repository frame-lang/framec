    factory Vec.fromJson(Map<String, dynamic> j) =>
        Vec((j['x'] as num).toDouble(), (j['y'] as num).toDouble());
}

class BagFrameEvent {
    late String _message;
    late List<dynamic> _parameters;

    BagFrameEvent(String message, List<dynamic> parameters) {
