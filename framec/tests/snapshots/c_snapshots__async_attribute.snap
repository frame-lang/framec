#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdint.h>

// ============================================================================
// AsyncFetcher_FrameDict - String-keyed dictionary
// ============================================================================

static char* AsyncFetcher_strdup_(const char* s) {
    size_t n = strlen(s) + 1;
    char* p = (char*)malloc(n);
    memcpy(p, s, n);
    return p;
}

typedef struct AsyncFetcher_FrameDictEntry {
    char* key;
    void* value;
    // 1 when `value` is a heap box this dict owns (a malloc'd
    // double from pack_double — #81): freed on overwrite and in
    // destroy, deep-copied by FrameDict_copy.
    int owned;
    struct AsyncFetcher_FrameDictEntry* next;
} AsyncFetcher_FrameDictEntry;

typedef struct {
    AsyncFetcher_FrameDictEntry** buckets;
    int bucket_count;
    int size;
} AsyncFetcher_FrameDict;

static unsigned int AsyncFetcher_hash_string(const char* str) {
    unsigned int hash = 5381;
    int c;
    while ((c = *str++)) {
        hash = ((hash << 5) + hash) + c;
    }
    return hash;
}

static AsyncFetcher_FrameDict* AsyncFetcher_FrameDict_new(void) {
    AsyncFetcher_FrameDict* d = malloc(sizeof(AsyncFetcher_FrameDict));
    d->bucket_count = 16;
    d->buckets = calloc(d->bucket_count, sizeof(AsyncFetcher_FrameDictEntry*));
    d->size = 0;
    return d;
}

static void AsyncFetcher_FrameDict_set_(AsyncFetcher_FrameDict* d, const char* key, void* value, int owned);
static void AsyncFetcher_FrameDict_set(AsyncFetcher_FrameDict* d, const char* key, void* value) {
    AsyncFetcher_FrameDict_set_(d, key, value, 0);
}

static void AsyncFetcher_FrameDict_set_owned(AsyncFetcher_FrameDict* d, const char* key, void* value) {
    AsyncFetcher_FrameDict_set_(d, key, value, 1);
}

static void AsyncFetcher_FrameDict_set_(AsyncFetcher_FrameDict* d, const char* key, void* value, int owned) {
    unsigned int idx = AsyncFetcher_hash_string(key) % d->bucket_count;
    AsyncFetcher_FrameDictEntry* entry = d->buckets[idx];
    while (entry) {
        if (strcmp(entry->key, key) == 0) {
            if (entry->owned && entry->value) free(entry->value);
            entry->value = value;
            entry->owned = owned;
            return;
        }
        entry = entry->next;
    }
    AsyncFetcher_FrameDictEntry* new_entry = malloc(sizeof(AsyncFetcher_FrameDictEntry));
    new_entry->key = AsyncFetcher_strdup_(key);
    new_entry->value = value;
    new_entry->owned = owned;
    new_entry->next = d->buckets[idx];
    d->buckets[idx] = new_entry;
    d->size++;
}

static void* AsyncFetcher_FrameDict_get(AsyncFetcher_FrameDict* d, const char* key) {
    unsigned int idx = AsyncFetcher_hash_string(key) % d->bucket_count;
    AsyncFetcher_FrameDictEntry* entry = d->buckets[idx];
    while (entry) {
        if (strcmp(entry->key, key) == 0) {
            return entry->value;
        }
        entry = entry->next;
    }
    return NULL;
}

static int AsyncFetcher_FrameDict_has(AsyncFetcher_FrameDict* d, const char* key) {
    unsigned int idx = AsyncFetcher_hash_string(key) % d->bucket_count;
    AsyncFetcher_FrameDictEntry* entry = d->buckets[idx];
    while (entry) {
        if (strcmp(entry->key, key) == 0) {
            return 1;
        }
        entry = entry->next;
    }
    return 0;
}

static AsyncFetcher_FrameDict* AsyncFetcher_FrameDict_copy(AsyncFetcher_FrameDict* src) {
    AsyncFetcher_FrameDict* dst = AsyncFetcher_FrameDict_new();
    for (int i = 0; i < src->bucket_count; i++) {
        AsyncFetcher_FrameDictEntry* entry = src->buckets[i];
        while (entry) {
            if (entry->owned && entry->value) {
                // Owned values are heap-boxed doubles (#81): deep-copy
                // so src and dst never alias (a shallow copy would
                // dangle when either side frees on overwrite/destroy).
                void* nb = malloc(sizeof(double));
                memcpy(nb, entry->value, sizeof(double));
                AsyncFetcher_FrameDict_set_(dst, entry->key, nb, 1);
            } else {
                AsyncFetcher_FrameDict_set_(dst, entry->key, entry->value, 0);
            }
            entry = entry->next;
        }
    }
    return dst;
}

static void AsyncFetcher_FrameDict_destroy(AsyncFetcher_FrameDict* d) {
    for (int i = 0; i < d->bucket_count; i++) {
        AsyncFetcher_FrameDictEntry* entry = d->buckets[i];
        while (entry) {
            AsyncFetcher_FrameDictEntry* next = entry->next;
            if (entry->owned && entry->value) free(entry->value);
            free(entry->key);
            free(entry);
            entry = next;
        }
    }
    free(d->buckets);
    free(d);
}

// ============================================================================
// AsyncFetcher_FrameVec - Dynamic array
// ============================================================================

typedef struct {
    void** items;
    // owned[i] == 1 when items[i] is a heap box this vec owns (a
    // malloc'd double from pack_double — #81): freed in destroy,
    // deep-copied by FrameVec_copy.
    unsigned char* owned;
    int size;
    int capacity;
} AsyncFetcher_FrameVec;

static AsyncFetcher_FrameVec* AsyncFetcher_FrameVec_new(void) {
    AsyncFetcher_FrameVec* v = malloc(sizeof(AsyncFetcher_FrameVec));
    v->capacity = 8;
    v->size = 0;
    v->items = malloc(sizeof(void*) * v->capacity);
    v->owned = calloc(v->capacity, 1);
    return v;
}

static void AsyncFetcher_FrameVec_push_(AsyncFetcher_FrameVec* v, void* item, unsigned char owned) {
    if (v->size >= v->capacity) {
        v->capacity *= 2;
        v->items = realloc(v->items, sizeof(void*) * v->capacity);
        v->owned = realloc(v->owned, v->capacity);
        memset(v->owned + v->size, 0, v->capacity - v->size);
    }
    v->owned[v->size] = owned;
    v->items[v->size++] = item;
}

static void AsyncFetcher_FrameVec_push(AsyncFetcher_FrameVec* v, void* item) {
    AsyncFetcher_FrameVec_push_(v, item, 0);
}

static void AsyncFetcher_FrameVec_push_owned(AsyncFetcher_FrameVec* v, void* item) {
    AsyncFetcher_FrameVec_push_(v, item, 1);
}

static void AsyncFetcher_FrameVec_clear(AsyncFetcher_FrameVec* v) {
    if (!v) return;
    for (int i = 0; i < v->size; i++) {
        if (v->owned[i] && v->items[i]) free(v->items[i]);
    }
    v->size = 0;
}

static void AsyncFetcher_FrameVec_extend(AsyncFetcher_FrameVec* dst, AsyncFetcher_FrameVec* src) {
    if (!src) return;
    for (int i = 0; i < src->size; i++) {
        if (src->owned[i] && src->items[i]) {
            void* nb = malloc(sizeof(double));
            memcpy(nb, src->items[i], sizeof(double));
            AsyncFetcher_FrameVec_push_(dst, nb, 1);
        } else {
            AsyncFetcher_FrameVec_push_(dst, src->items[i], 0);
        }
    }
}

static void* AsyncFetcher_FrameVec_pop(AsyncFetcher_FrameVec* v) {
    if (v->size == 0) return NULL;
    return v->items[--v->size];
}

static void* AsyncFetcher_FrameVec_last(AsyncFetcher_FrameVec* v) {
    if (v->size == 0) return NULL;
    return v->items[v->size - 1];
}

static void* AsyncFetcher_FrameVec_get(AsyncFetcher_FrameVec* v, int index) {
    if (index < 0 || index >= v->size) return NULL;
    return v->items[index];
}

static int AsyncFetcher_FrameVec_size(AsyncFetcher_FrameVec* v) {
    return v->size;
}

static void AsyncFetcher_FrameVec_destroy(AsyncFetcher_FrameVec* v) {
    if (!v) return;
    for (int i = 0; i < v->size; i++) {
        if (v->owned[i] && v->items[i]) free(v->items[i]);
    }
    free(v->owned);
    free(v->items);
    free(v);
}

static AsyncFetcher_FrameVec* AsyncFetcher_FrameVec_copy(AsyncFetcher_FrameVec* src) {
    if (!src) return NULL;
    AsyncFetcher_FrameVec* v = AsyncFetcher_FrameVec_new();
    AsyncFetcher_FrameVec_extend(v, src);
    return v;
}

// ============================================================================
// AsyncFetcher_pack_double / AsyncFetcher_unpack_double — heap-boxed doubles (#81:
// pointer-width independent; the old void* bit-pun overflowed on 32-bit)
// ============================================================================

static inline void* AsyncFetcher_pack_double(double v) {
    double* p = (double*)malloc(sizeof(double));
    *p = v;
    return (void*)p;
}

static inline double AsyncFetcher_unpack_double(void* p) {
    return p ? *(double*)p : 0.0;
}

// ============================================================================
#define AsyncFetcher_ARG_IS_FLOAT(v) _Generic((v), double:1, float:1, long double:1, default:0)
#define AsyncFetcher_ARG_DBL(v) _Generic((v), double:(v), float:(v), long double:(double)0, default:(double)0)
#define AsyncFetcher_ARG_WORD(v) _Generic((v), double:(void*)0, float:(void*)0, long double:(void*)0, default:(void*)(intptr_t)(v))
#define AsyncFetcher_ARG_PUSH(vec, v) ( AsyncFetcher_ARG_IS_FLOAT(v) \
    ? AsyncFetcher_FrameVec_push_owned((vec), AsyncFetcher_pack_double(AsyncFetcher_ARG_DBL(v))) \
    : AsyncFetcher_FrameVec_push((vec), AsyncFetcher_ARG_WORD(v)) )

// ============================================================================
// AsyncFetcher_FrameEvent - Event routing object
// ============================================================================

typedef struct {
    const char* _message;
    AsyncFetcher_FrameVec* _parameters;
    int _owns_parameters;
} AsyncFetcher_FrameEvent;

static AsyncFetcher_FrameEvent* AsyncFetcher_FrameEvent_new(const char* message, AsyncFetcher_FrameVec* parameters, int owns_parameters) {
    AsyncFetcher_FrameEvent* e = malloc(sizeof(AsyncFetcher_FrameEvent));
    e->_message = message;
    e->_parameters = parameters;
    e->_owns_parameters = owns_parameters;
    return e;
}

static void AsyncFetcher_FrameEvent_destroy(AsyncFetcher_FrameEvent* e) {
    if (e->_owns_parameters && e->_parameters) AsyncFetcher_FrameVec_destroy(e->_parameters);
    free(e);
}

// ============================================================================
// AsyncFetcher_FrameContext - Interface call context
// ============================================================================

typedef struct {
    AsyncFetcher_FrameEvent* event;
    void* _return;
    AsyncFetcher_FrameDict* _data;
    int _transitioned;
} AsyncFetcher_FrameContext;

static AsyncFetcher_FrameContext* AsyncFetcher_FrameContext_new(AsyncFetcher_FrameEvent* event, void* default_return) {
    AsyncFetcher_FrameContext* ctx = malloc(sizeof(AsyncFetcher_FrameContext));
    ctx->event = event;
    ctx->_return = default_return;
    ctx->_data = AsyncFetcher_FrameDict_new();
    ctx->_transitioned = 0;
    return ctx;
}

static void AsyncFetcher_FrameContext_destroy(AsyncFetcher_FrameContext* ctx) {
    AsyncFetcher_FrameDict_destroy(ctx->_data);
    free(ctx);
}

// ============================================================================
// AsyncFetcher_Compartment - State closure
// ============================================================================

typedef struct AsyncFetcher_Compartment {
    const char* state;
    AsyncFetcher_FrameVec* state_args;
    AsyncFetcher_FrameDict* state_vars;
    AsyncFetcher_FrameVec* enter_args;
    AsyncFetcher_FrameVec* exit_args;
    AsyncFetcher_FrameEvent* forward_event;
    struct AsyncFetcher_Compartment* parent_compartment;
    int _ref_count;
} AsyncFetcher_Compartment;

static AsyncFetcher_Compartment* AsyncFetcher_Compartment_new(const char* state) {
    AsyncFetcher_Compartment* c = malloc(sizeof(AsyncFetcher_Compartment));
    c->state = state;
    c->state_args = AsyncFetcher_FrameVec_new();
    c->state_vars = AsyncFetcher_FrameDict_new();
    c->enter_args = AsyncFetcher_FrameVec_new();
    c->exit_args = AsyncFetcher_FrameVec_new();
    c->forward_event = NULL;
    c->parent_compartment = NULL;
    c->_ref_count = 1;
    return c;
}

static AsyncFetcher_Compartment* AsyncFetcher_Compartment_ref(AsyncFetcher_Compartment* c) {
    if (c) c->_ref_count++;
    return c;
}

static void AsyncFetcher_Compartment_unref(AsyncFetcher_Compartment* c);
static void AsyncFetcher_Compartment_unref(AsyncFetcher_Compartment* c) {
    if (c == NULL) return;
    c->_ref_count--;
    if (c->_ref_count <= 0) {
        AsyncFetcher_Compartment_unref(c->parent_compartment);
        AsyncFetcher_FrameVec_destroy(c->state_args);
        AsyncFetcher_FrameDict_destroy(c->state_vars);
        AsyncFetcher_FrameVec_destroy(c->enter_args);
        AsyncFetcher_FrameVec_destroy(c->exit_args);
        free(c);
    }
}

static AsyncFetcher_Compartment* AsyncFetcher_Compartment_copy(AsyncFetcher_Compartment* src) {
    AsyncFetcher_Compartment* c = malloc(sizeof(AsyncFetcher_Compartment));
    c->state = src->state;
    c->state_args = AsyncFetcher_FrameVec_copy(src->state_args);
    c->state_vars = AsyncFetcher_FrameDict_copy(src->state_vars);
    c->enter_args = AsyncFetcher_FrameVec_copy(src->enter_args);
    c->exit_args = AsyncFetcher_FrameVec_copy(src->exit_args);
    c->forward_event = src->forward_event;  // Shallow copy OK
    c->parent_compartment = src->parent_compartment;
    return c;
}

static void AsyncFetcher_Compartment_destroy(AsyncFetcher_Compartment* c) {
    AsyncFetcher_FrameVec_destroy(c->state_args);
    AsyncFetcher_FrameDict_destroy(c->state_vars);
    AsyncFetcher_FrameVec_destroy(c->enter_args);
    AsyncFetcher_FrameVec_destroy(c->exit_args);
    free(c);
}

// Helper macros for context access
#define AsyncFetcher_CTX(self) ((AsyncFetcher_FrameContext*)AsyncFetcher_FrameVec_last((self)->_context_stack))
#define AsyncFetcher_PARAM(self, key) AsyncFetcher_FrameDict_get(AsyncFetcher_CTX(self)->event->_parameters, key)
#define AsyncFetcher_RETURN(self) AsyncFetcher_CTX(self)->_return
#define AsyncFetcher_DATA(self, key) AsyncFetcher_FrameDict_get(AsyncFetcher_CTX(self)->_data, key)
#define AsyncFetcher_DATA_SET(self, key, val) AsyncFetcher_FrameDict_set(AsyncFetcher_CTX(self)->_data, key, val)

// Forward declarations
typedef struct AsyncFetcher AsyncFetcher;
static void AsyncFetcher_kernel(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e);
static void AsyncFetcher_router(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e);
static void AsyncFetcher_transition(AsyncFetcher* self, AsyncFetcher_Compartment* next);
static int AsyncFetcher_hsm_chain(AsyncFetcher* self, const char* leaf, const char*** out_chain);
static AsyncFetcher_Compartment* AsyncFetcher_prepareEnter(AsyncFetcher* self, const char* leaf, AsyncFetcher_FrameVec* state_args, AsyncFetcher_FrameVec* enter_args);
static void AsyncFetcher_prepareExit(AsyncFetcher* self, AsyncFetcher_FrameVec* exit_args);
static void AsyncFetcher_state_Ready(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e, AsyncFetcher_Compartment* compartment);
static void AsyncFetcher_s_Ready_hdl_user_fetch(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e, AsyncFetcher_Compartment* compartment);
char* AsyncFetcher_fetch (AsyncFetcher* self, char* key);
void AsyncFetcher_init (AsyncFetcher* self);

struct AsyncFetcher {
    AsyncFetcher_FrameVec* _state_stack;
    AsyncFetcher_Compartment* __compartment;
    AsyncFetcher_Compartment* __next_compartment;
    AsyncFetcher_FrameVec* _context_stack;
    Cache cache;
};

AsyncFetcher* AsyncFetcher_new(void) {
    AsyncFetcher* self = calloc(1, sizeof(AsyncFetcher));
    self->_state_stack = AsyncFetcher_FrameVec_new();
    self->_context_stack = AsyncFetcher_FrameVec_new();
    self->cache = nil;
    AsyncFetcher_FrameVec* __sa = NULL;
    AsyncFetcher_FrameVec* __ea = NULL;
    self->__compartment = AsyncFetcher_prepareEnter(self, "Ready", __sa, __ea);
    self->__next_compartment = NULL;
    return self;
}

AsyncFetcher* AsyncFetcher_create(void) {
    AsyncFetcher* self = AsyncFetcher_new();
    self->_state_stack = AsyncFetcher_FrameVec_new();
    self->_context_stack = AsyncFetcher_FrameVec_new();
    self->cache = nil;
    AsyncFetcher_FrameVec* __sa = NULL;
    AsyncFetcher_FrameVec* __ea = NULL;
    self->__compartment = AsyncFetcher_prepareEnter(self, "Ready", __sa, __ea);
    self->__next_compartment = NULL;
    return self;
}

static int AsyncFetcher_hsm_chain(AsyncFetcher* self, const char* leaf, const char*** out_chain) {
    if (false) { (void)0; }
        else if (strcmp(leaf, "Ready") == 0) {
            static const char* __chain[] = { "Ready" };
            *out_chain = __chain;
            return 1;
        }
        *out_chain = NULL;
        return 0;
}

static AsyncFetcher_Compartment* AsyncFetcher_prepareEnter(AsyncFetcher* self, const char* leaf, AsyncFetcher_FrameVec* state_args, AsyncFetcher_FrameVec* enter_args) {
    const char** chain = NULL;
    int n = AsyncFetcher_hsm_chain(self, leaf, &chain);
    AsyncFetcher_Compartment* comp = NULL;
    for (int i = 0; i < n; i++) {
        AsyncFetcher_Compartment* nc = AsyncFetcher_Compartment_new(chain[i]);
        // FrameVec_extend deep-copies vec-owned heap boxes (#81: doubles)
        // so the caller can destroy its arg vecs after this returns.
        AsyncFetcher_FrameVec_extend(nc->state_args, state_args);
        AsyncFetcher_FrameVec_extend(nc->enter_args, enter_args);
        nc->parent_compartment = comp;  // adopts ref
        comp = nc;
    }
    return comp;
}

static void AsyncFetcher_prepareExit(AsyncFetcher* self, AsyncFetcher_FrameVec* exit_args) {
    AsyncFetcher_Compartment* comp = self->__compartment;
    while (comp != NULL) {
        // Clear any prior exit_args (freeing vec-owned boxes, #81) before
        // copying the new ones in; extend deep-copies owned entries.
        AsyncFetcher_FrameVec_clear(comp->exit_args);
        AsyncFetcher_FrameVec_extend(comp->exit_args, exit_args);
        comp = comp->parent_compartment;
    }
}

static void AsyncFetcher_kernel(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e) {
    AsyncFetcher_router(self, __e);
    while (self->__next_compartment != NULL) {
        AsyncFetcher_Compartment* next_compartment = self->__next_compartment;
        self->__next_compartment = NULL;
        // Exit the current (leaf) state
        AsyncFetcher_FrameEvent* __exit_event = AsyncFetcher_FrameEvent_new("<$", self->__compartment->exit_args, 0);
        AsyncFetcher_router(self, __exit_event);
        AsyncFetcher_FrameEvent_destroy(__exit_event);
        AsyncFetcher_Compartment_unref(self->__compartment);
        self->__compartment = next_compartment;
        if (next_compartment->forward_event == NULL) {
            // No forwarded event — synthesize a fresh $>
            AsyncFetcher_FrameEvent* __enter_event = AsyncFetcher_FrameEvent_new("$>", self->__compartment->enter_args, 0);
            AsyncFetcher_router(self, __enter_event);
            AsyncFetcher_FrameEvent_destroy(__enter_event);
        } else if (strcmp(next_compartment->forward_event->_message, "$>") == 0) {
            // Forwarded event IS $> — dispatch directly so the
            // destination's $> handler receives the caller's payload.
            // The forward_event is borrowed (owned by the wrapper that
            // queued the transition) — do NOT destroy it here.
            AsyncFetcher_FrameEvent* forward_event = next_compartment->forward_event;
            next_compartment->forward_event = NULL;
            AsyncFetcher_router(self, forward_event);
        } else {
            // Forwarded event is not $> — initialize the destination
            // with a fresh $>, then dispatch the forward to it. The
            // forward_event is borrowed; only the synthesized $> belongs
            // to the kernel and is freed here.
            AsyncFetcher_FrameEvent* forward_event = next_compartment->forward_event;
            next_compartment->forward_event = NULL;
            AsyncFetcher_FrameEvent* __enter_event = AsyncFetcher_FrameEvent_new("$>", self->__compartment->enter_args, 0);
            AsyncFetcher_router(self, __enter_event);
            AsyncFetcher_FrameEvent_destroy(__enter_event);
            AsyncFetcher_router(self, forward_event);
        }
        // Mark every stacked context as having transitioned. Read by
        // @@:self.X() guard so outer self-calls short-circuit.
        for (int __i = 0; __i < self->_context_stack->size; __i++) {
            ((AsyncFetcher_FrameContext*)self->_context_stack->items[__i])->_transitioned = 1;
        }
    }
}

static void AsyncFetcher_router(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e) {
    if (strcmp(self->__compartment->state, "Ready") == 0) {
        AsyncFetcher_state_Ready(self, __e, self->__compartment);
    }
}

static void AsyncFetcher_transition(AsyncFetcher* self, AsyncFetcher_Compartment* next_compartment) {
    self->__next_compartment = next_compartment;
}

void AsyncFetcher_destroy(AsyncFetcher* self) {
    // Unref current compartment (may free if not on stack)
    if (self->__compartment) AsyncFetcher_Compartment_unref(self->__compartment);
    if (self->__next_compartment) AsyncFetcher_Compartment_unref(self->__next_compartment);
    // Unref all state stack entries
    if (self->_state_stack) {
        for (int __i = 0; __i < self->_state_stack->size; __i++) {
            AsyncFetcher_Compartment_unref((AsyncFetcher_Compartment*)self->_state_stack->items[__i]);
        }
        AsyncFetcher_FrameVec_destroy(self->_state_stack);
    }
    if (self->_context_stack) AsyncFetcher_FrameVec_destroy(self->_context_stack);
    free(self);
}

char* AsyncFetcher_fetch(AsyncFetcher* self, char* key) {
    AsyncFetcher_FrameVec* __params = AsyncFetcher_FrameVec_new();
    AsyncFetcher_FrameVec_push(__params, (void*)(intptr_t)key);
    AsyncFetcher_FrameEvent* __e = AsyncFetcher_FrameEvent_new("fetch", __params, 1);
    AsyncFetcher_FrameContext* __ctx = AsyncFetcher_FrameContext_new(__e, NULL);
    AsyncFetcher_FrameVec_push(self->_context_stack, __ctx);
    AsyncFetcher_kernel(self, __e);
    AsyncFetcher_FrameContext* __result_ctx = (AsyncFetcher_FrameContext*)AsyncFetcher_FrameVec_pop(self->_context_stack);
    char* __result = (char*)__result_ctx->_return;
    AsyncFetcher_FrameContext_destroy(__result_ctx);
    AsyncFetcher_FrameEvent_destroy(__e);
    return __result;
}

static void AsyncFetcher_state_Ready(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e, AsyncFetcher_Compartment* compartment) {
    if (strcmp(__e->_message, "fetch") == 0) {
        AsyncFetcher_s_Ready_hdl_user_fetch(self, __e, compartment);
        return;
    }
}

static void AsyncFetcher_s_Ready_hdl_user_fetch(AsyncFetcher* self, AsyncFetcher_FrameEvent* __e, AsyncFetcher_Compartment* compartment) {
    const char* key = (const char*)AsyncFetcher_FrameVec_get(__e->_parameters, 0);
    (void)key;
    AsyncFetcher_CTX(self)->_return = (void*)(intptr_t)(self->cache.get(key));
}

void AsyncFetcher_init(AsyncFetcher* self) {
    // async not supported for C
}
