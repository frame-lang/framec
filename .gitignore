# Build artifacts
target/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python cache (from test harnesses)
__pycache__/
*.pyc
*.pyo

# Local scratch space for in-progress design work — never committed
_scratch/

# Claude Code local settings + the agent roster stay local (not published).
.claude/*

# Project-internal AI agent context (kept local, not published)
CLAUDE.md

# Runtime / crash artifacts — never track (can leak file paths, memory, in-flight data)
*.dump
erl_crash.dump
